NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# Project Settings > API in Supabase
SUPABASE_URL=https://your-project-ref.supabase.co

# Use only on the backend. Never expose this key in index.html or browser JS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Create a long random value and use it to enter the admin panel.
ADMIN_API_KEY=change-this-admin-key-with-at-least-16-chars

# Comma-separated allowed origins.
# "null" allows testing index.html opened directly with file://
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,null
